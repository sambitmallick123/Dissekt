# ============================================
# DISSEKT - Environment Variables
# Copy this to .env and fill in your values
# ============================================

# --- Core ---
APP_ENV=development
APP_NAME=Dissekt
APP_VERSION=0.1.0
DEBUG=true

# --- LLM API Keys ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
# Optional: Google Gemini
GOOGLE_API_KEY=

# --- Database (Supabase) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJxxxxx
SUPABASE_SERVICE_KEY=eyJxxxxx

# --- Cache (Redis / Upstash) ---
REDIS_URL=rediss://default:xxxxx@xxxxx.upstash.io:6379
REDIS_CACHE_TTL_BRIEF=86400
REDIS_CACHE_TTL_DETAILED=259200

# --- Vector Store (Qdrant) ---
QDRANT_URL=https://xxxxx.qdrant.io
QDRANT_API_KEY=xxxxx
QDRANT_COLLECTION=dissekt_analyses

# --- Search APIs ---
# Google Fact Check (free, get from Google Cloud Console)
GOOGLE_FACTCHECK_API_KEY=xxxxx
# SerpAPI (or use Brave Search as alternative)
SERPAPI_KEY=xxxxx
# Alternative: Brave Search API
BRAVE_SEARCH_API_KEY=

# --- Analysis Config ---
CONFIDENCE_THRESHOLD=0.60
MAX_BRIEF_LENGTH=300
MAX_DETAILED_LENGTH=3000

# --- Rate Limiting ---
RATE_LIMIT_FREE=3
RATE_LIMIT_PRO=100
